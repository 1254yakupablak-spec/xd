{
  "manifest_version": 3,
  "name": "KOKLEYİCİ SPORTS",
  "version": "4.5.2",
  "description": "6q Özel Oranlar (Goal Mix): 1xBet ve sitenin maç oranlarından adil oran hesaplayıp kupon önerir.",
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://raw.githubusercontent.com/*",
    "https://1xbet.com/*",
    "https://*.1xbet.com/*",
    "https://site.web.api.espn.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://6q.net/*",
        "https://*.6q.net/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*/*"
      ],
      "js": [
        "feed-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*/*"
      ],
      "js": [
        "xbet.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "KOKLEYİCİ SPORTS",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "teams.json"
      ],
      "matches": [
        "https://6q.net/*",
        "https://*.6q.net/*"
      ]
    }
  ]
}
